{
  "name": "abitat-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "cloud": "node scripts/cloud.mjs",
    "cloud:dev": "node scripts/cloud-dev.mjs",
    "cloud:host": "node scripts/cloud-host.mjs",
    "cloud:up": "node scripts/cloud.mjs",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:migrate:dev": "pnpm --filter web db:migrate:dev",
    "db:seed": "pnpm --filter web db:seed",
    "db:validate": "pnpm --filter web db:validate",
    "dev": "pnpm --parallel --filter web --filter @abitat_reece/host-daemon run dev",
    "dev:daemon": "pnpm --filter @abitat_reece/host-daemon dev",
    "dev:iphone": "node scripts/dev-iphone.mjs",
    "dev:mac": "pnpm mac:start",
    "dev:web": "pnpm --filter web dev",
    "format": "prettier --check .",
    "iphone": "node scripts/dev-iphone.mjs",
    "lint": "pnpm -r lint",
    "mac:build": "pnpm --filter @abitat_reece/shared build && pnpm --filter @abitat_reece/host-daemon build && node scripts/build-mac-native-app.mjs",
    "mac:start": "pnpm mac:build && apps/mac-native/dist/Abitat.app/Contents/MacOS/AbitatMac",
    "mac:test": "swift test --package-path apps/mac-native && pnpm --filter @abitat_reece/host-daemon exec vitest run tests/local-control-desktop-server.test.ts",
    "smoke:public-install": "node scripts/public-install-smoke.mjs",
    "smoke:published-install": "node scripts/published-install-smoke.mjs",
    "test:homebrew": "node scripts/validate-homebrew-formula.mjs",
    "test": "pnpm --filter @abitat_reece/shared build && pnpm -r test",
    "typecheck": "pnpm --filter @abitat_reece/shared build && pnpm db:generate && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "ws": "^8.20.0",
    "eslint": "10.2.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.0",
    "vitest": "4.1.5"
  }
}
