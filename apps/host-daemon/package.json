{
  "name": "@abitat_reece/host-daemon",
  "private": false,
  "version": "0.1.1",
  "type": "module",
  "description": "Mac host daemon for Abitat Workspace remote Codex control",
  "bin": {
    "abitat-host": "dist/cli/index.js"
  },
  "exports": {
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm --filter @abitat_reece/shared build",
    "dev": "tsx src/cli/index.ts start",
    "dev:mock": "tsx src/cli/index.ts start --mock",
    "lint": "eslint .",
    "pretest": "pnpm --filter @abitat_reece/shared build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@abitat_reece/shared": "workspace:*",
    "node-pty": "^1.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "4.21.0"
  }
}
