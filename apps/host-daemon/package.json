{
  "name": "host-daemon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "abitat-host": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "pnpm --filter @abitat/shared build",
    "dev": "tsx src/cli/index.ts start",
    "dev:mock": "tsx src/cli/index.ts start --mock",
    "lint": "eslint .",
    "pretest": "pnpm --filter @abitat/shared build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@abitat/shared": "workspace:*",
    "node-pty": "^1.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "4.21.0"
  }
}
