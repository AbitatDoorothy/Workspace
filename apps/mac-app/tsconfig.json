{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node", "electron"]
  },
  "include": ["src/main/**/*.ts", "src/preload.ts", "src/shared/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
