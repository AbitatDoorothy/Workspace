{
  "name": "@abitat_reece/mac-app",
  "private": true,
  "version": "0.1.0",
  "description": "Abitat Mac desktop app for local-first Codex control",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "tsx scripts/dev.mts",
    "lint": "eslint .",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@abitat_reece/host-daemon": "workspace:*",
    "@abitat_reece/shared": "workspace:*",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "4.1.5"
  }
}
