{
  "name": "@abitat_reece/cli",
  "private": false,
  "version": "0.1.11",
  "description": "Remote Codex control from Mac and iPhone",
  "type": "module",
  "bin": {
    "abitat": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@abitat_reece/host-daemon": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
