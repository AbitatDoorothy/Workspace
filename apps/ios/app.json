{
  "expo": {
    "name": "Remote Abitat",
    "slug": "abitat-ios",
    "scheme": "abitat",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "io.abitat.workspace",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Abitat scans the pairing QR code shown on your Mac.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      },
      "buildNumber": "16"
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/notifications/codex-done-1.wav",
            "./assets/notifications/codex-done-2.wav",
            "./assets/notifications/codex-done-3.wav"
          ]
        }
      ]
    ],
    "extra": {
      "defaultApiUrl": "http://127.0.0.1:3901",
      "eas": {
        "projectId": "a04ce550-f89e-40b6-9426-3af635b23ee3"
      }
    },
    "owner": "reece_yan"
  }
}
