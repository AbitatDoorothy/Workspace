{
  "expo": {
    "name": "Abitat",
    "slug": "abitat-ios",
    "scheme": "abitat",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "io.abitat.workspace",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Abitat scans the pairing QR code shown on your Mac."
      }
    },
    "plugins": ["expo-secure-store", "expo-camera", "expo-notifications"],
    "extra": {
      "defaultApiUrl": "https://workspace.abitat.io",
      "eas": {
        "projectId": "3ed2d5ef-0351-4642-9edb-3f6783409efb"
      }
    }
  }
}
