{
  "name": "@abitat_reece/relay",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloudflare relay for local-first Abitat mobile control",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
